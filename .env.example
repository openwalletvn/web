# =============================================================================
# OpenWallet Web — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# OpenWallet API  (api.openwallet.vn)
# Key: ask team or check Cloudflare dashboard → Workers → openwallet-api → Secrets
# -----------------------------------------------------------------------------
OPENWALLET_API_KEY=your-api-key-here
NEXT_PUBLIC_API_URL=https://api.openwallet.vn

# -----------------------------------------------------------------------------
# OpenWallet MCP  (mcp.openwallet.vn)
# Key: listed in MCP_KEYS secret on Cloudflare → Workers → openwallet-mcp → Secrets
# Server-only — never use NEXT_PUBLIC_ prefix
# -----------------------------------------------------------------------------
OPENWALLET_MCP_URL=https://mcp.openwallet.vn
OPENWALLET_MCP_KEY=

# -----------------------------------------------------------------------------
# OpenRouter LLM  (openrouter.ai/keys)
# Used by /api/chat route — server-only, never expose to client
# Model: see https://openrouter.ai/models
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Fallback model for all AI services — override per-service via CHAT_MODEL / EVAL_CHAT_MODEL
# If unset, services that require a model will stop gracefully instead of throwing
# DEFAULT_MODEL=google/gemini-flash-1.5
# Production chat model — answers user questions in /api/chat (falls back to DEFAULT_MODEL)
CHAT_MODEL=google/gemini-flash-1.5
# Eval harness: model under test (falls back to DEFAULT_MODEL)
# EVAL_CHAT_MODEL=google/gemini-flash-1.5
# Eval harness: judge model that scores EVAL_CHAT_MODEL responses pass/fail
# EVAL_JUDGE_MODEL=openai/gpt-4o-mini

